.DS_Store
Thumbs.db

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# User persistent data
data/user_data.json
data/*.tmp
!data/.gitkeep

# Auto-updated tag lists, update state and related-tags cache
data/*.csv
data/tag_update_state.json
data/related-tags/

# wildcards & translation csv
tags/translations/*
tags/wildcards/*
!tags/translations/.gitkeep
!tags/wildcards/.gitkeep